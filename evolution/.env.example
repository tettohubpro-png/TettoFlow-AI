# Copie para evolution/.env (mesma pasta do docker-compose.yml) e preencha
# com valores fortes/únicos antes de rodar `docker compose up`.
# NUNCA commite o .env real — já está coberto pelo .gitignore (.env*).

EVOLUTION_POSTGRES_PASSWORD=troque-por-um-valor-forte-e-unico
